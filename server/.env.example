# ---------------------------------------------------------------------------
# SecureChat server configuration
# Copy to `.env` and fill in. NEVER put a private key or any secret derived
# from user key material in this file - the server must stay zero-knowledge.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# The address CLIENTS reach this server on. It is written into every media URL
# the API hands out, so it must be an address the device in question can
# resolve: 10.0.2.2 is the Android emulator's alias for the host machine, while
# a phone on the Wi-Fi needs this machine's own LAN address, e.g.
#   PUBLIC_URL=http://192.168.0.100:4000
# The banner printed on startup lists that address. Getting this wrong shows up
# as chats working and photos never loading.
PUBLIC_URL=http://10.0.2.2:4000

# LAN discovery: a fresh install broadcasts a datagram on UDP and the server
# answers with its address, so nobody has to type anything by hand.
# Set DISCOVERY_PORT=0 to switch the responder off.
DISCOVERY_PORT=41234
DISCOVERY_NAME=SecureChat server

# --- Secrets -----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000
ACCESS_TOKEN_TTL=30d

# --- Database ----------------------------------------------------------------
# AUTO_DB=mongo     -> use MONGODB_URI exactly as written. Required for Atlas.
# AUTO_DB=embedded  -> start a local mongod inside this process, storing data in
#                      EMBEDDED_DB_DIR. Nothing to install, nothing to administer.
#                      Ideal for a self-hosted LAN deployment.
#
# --- Managed MongoDB (Atlas and friends) -------------------------------------
# 1. Create a FREE (M0) cluster, add a database user, and in Network Access allow
#    either this machine's public IP or 0.0.0.0/0. "Allow from anywhere" makes
#    that password the only thing standing between a stranger and your messages,
#    so use a long random one and prefer the single-IP rule.
# 2. Copy the connection string from Connect -> Drivers. Encode the password
#    into it (Secure@123 -> Secure%40123) - Atlas hands you a URI with that
#    already done, which is why copying beats typing.
# 3. Paste it as MONGODB_URI, set AUTO_DB=mongo, then:
#       npm run check:db       # proves the URI, DNS, allowlist and credentials
#       npm run migrate:db -- --dry-run   # compares to the old database first
# The server refuses to boot without a working database, so run check:db before
# restarting it rather than reading a 10-second timeout as a broken app.
AUTO_DB=embedded
MONGODB_URI=mongodb://127.0.0.1:27017/securechat
EMBEDDED_DB_DIR=./var/db
EMBEDDED_DB_PORT=27018

# --- Passwords --------------------------------------------------------------
# Passwords are hashed with scrypt on this server. Only the hash and a random
# salt are stored; the password itself is never persisted, logged or returned.
# There is NO password reset flow, because recovering an account would require
# either the password or a channel this design deliberately does not have.
#
# Sign-up rules: a phone number can be registered exactly once. Repeat attempts
# are refused with 409 and never modify the existing account.
#
# Brute-force protection is layered: AUTH_RATE_LIMIT_MAX caps attempts per IP
# per minute, and these two lock the individual account after repeated failures
# so a distributed attack from many IPs still cannot grind one account.
AUTH_RATE_LIMIT_MAX=10
MAX_FAILED_LOGINS=8
LOCK_MINUTES=15

# --- Object storage (S3 / MinIO / local disk) --------------------------------
# STORAGE_DRIVER=local  -> encrypted blobs are written to ./var/media
# STORAGE_DRIVER=s3     -> AWS S3 (or any S3-compatible endpoint such as MinIO)
STORAGE_DRIVER=local
MEDIA_DIR=./var/media
MEDIA_MAX_BYTES=26214400
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESIGN_TTL_SECONDS=900

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_MAX=120

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=*
