# Normalise line endings in the repository, check out with native endings.
# Keeps the same file from showing as "modified" on Windows and Linux.
* text=auto eol=lf

# Shell scripts must stay LF or they break when run on Linux/macOS.
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# PowerShell is fine either way, but pin it for consistency.
*.ps1 text eol=crlf

# --- Binary files: never diff, never line-ending convert ---------------------
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.p12 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# --- Lock files: keep them, but stop Git from reformatting them ---------------
pubspec.lock -diff
package-lock.json -diff
